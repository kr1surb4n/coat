#!/bin/bash

# machine specific settings and secrets, not part of the repository
[ -f ~/.env ] && source ~/.env

# terminal type: Coat does not force it; your terminal/tmux/ssh should set it.
# Uncomment one only when the value is wrong. Common choices:
#   xterm-256color      a normal 256-colour xterm
#   tmux-256color       inside tmux
#   screen-256color     inside screen (or a tmux that reports screen)
#   linux               the Linux console
#   dumb                no escape sequences, plain logs
# Check a value with: infocmp xterm-256color
# export TERM="xterm-256color"

# history: Bash keeps the list in memory and writes it to $HISTFILE.
# Negative values mean "no limit"; 0 disables history. The practical limit is
# memory and disk. Use e.g. 100000/200000 for a bounded history.
export HISTSIZE=-1
export HISTFILESIZE=-1
# keep consecutive duplicates out, but save everything else (including cd/ls/pwd)
export HISTCONTROL=ignoredups
export HISTIGNORE=
# append instead of replacing the history file when a shell exits
shopt -s histappend

# coat configuration
export PATH_TO_COAT=~/.coat
export COAT_MODULES=$PATH_TO_COAT/modules
export COAT_STORAGE=$PATH_TO_COAT/storage
export COAT_PACKAGES=$PATH_TO_COAT/packages
export COAT_LIBS=$PATH_TO_COAT/libs

# runtime files
export SPOT_FILE=$COAT_STORAGE/spot
export FOLDER_BOOKMARK_FILE=$COAT_STORAGE/bookmarks
export TELEPORTS=$COAT_STORAGE/teleports
export DIRTY_NOTES=$COAT_STORAGE/dirty_notes
export FILE_MARKERS=$COAT_STORAGE/marks

# spells
export SPELLS=~/.dotfiles/spells
export MAGI_BOOK=$SPELLS/magi_book
export BASH_SPELLS=$SPELLS/bash
export DIAGNOSTICS_SPELLS=$SPELLS/diagnostics
export PROGRAMS_SPELLS=$SPELLS/programs
export NET_SPELLS=$SPELLS/network
export DOCKER_SPELLS=$SPELLS/docker
export PGSQL_SPELLS=$SPELLS/postgresql
export GIT_COMMANDS_FILE=$SPELLS/git_commands
export AWS_SPELLS=$SPELLS/aws
export SECRETS_SPELLS=$SPELLS/secrets

# spellbook, one file per group
export MAGIC_BOOKS="$MAGI_BOOK \
                    $BASH_SPELLS \
                    $DIAGNOSTICS_SPELLS \
                    $PROGRAMS_SPELLS \
                    $NET_SPELLS \
                    $GIT_COMMANDS_FILE \
                    $DOCKER_SPELLS \
                    $AWS_SPELLS \
                    $SECRETS_SPELLS \
                    $PGSQL_SPELLS"

# foxer browser profiles
export FIREFOX_BINARY=$HOME/bin/firefox/firefox
export FOXER_PROFILES=$HOME/profiles
export CHROMER_PROFILES=$HOME/profiles

# tmuxp layouts
export TMUXP_CONFIGDIR=~/.dotfiles/tmux

# folder with the bash completion scripts
export BASH_COMPLETION_USER_DIR=$HOME/.config/bash-completion

# options passed to grep by the aliases
export GREP_OPTIONS="-s "

# paczek fillings
export PACZEK_FILLINGS=$PATH_TO_COAT/lib/paczki

# name of the python virtual env folder
export VENV_FOLDER=".venv"

# terminal type
export TERMINAL="xterm256"

# PATH
export PATH=$PATH:~/bin:$PATH_TO_COAT/lib
export PATH="$PATH:$PATH_TO_COAT/lib/foxer"
export PATH="$PATH:$HOME/.local/bin"

# node
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# pyenv
export PATH="$HOME/.pyenv/bin:$PATH"

# direnv hook, only when direnv is installed
command -v direnv >/dev/null && eval "$(direnv hook bash)"

# add ssh-key to ssh-agent when key exist
if [ "$SSH_AUTH_SOCK" != "" ] && [ -f ~/.ssh/id_rsa ] && [ -x /usr/bin/ssh-add  ]; then
  ssh-add -l >/dev/null || alias ssh='(ssh-add -l >/dev/null || ssh-add) && unalias ssh; ssh'
fi

# load the coat
source $PATH_TO_COAT/coat.sh
